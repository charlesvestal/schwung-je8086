# JUCE/CLAP plugin build for aarch64 Linux (Pi / SBC).
#
# The container is arm64 natively on Apple Silicon, so g++ already targets
# aarch64-linux-gnu and the distro's own -dev packages ARE the target's. No
# cross toolchain and no multiarch: an earlier attempt added arm64 multiarch to
# what it assumed was an amd64 base and mislabelled ports.ubuntu.com as amd64.
#
# 22.04 (glibc 2.35) is deliberate: older than the Pi's Debian 13 (2.41), and
# glibc is forward compatible.
FROM ubuntu:22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build make file git pkg-config ca-certificates \
      libasound2-dev \
      libx11-dev libxext-dev libxrandr-dev libxinerama-dev libxcursor-dev libxcomposite-dev \
      libfreetype6-dev libfontconfig1-dev \
      libgl1-mesa-dev libglu1-mesa-dev \
      libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

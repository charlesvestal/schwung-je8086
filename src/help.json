{
  "title": "JE-8086",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "JE-8086",
        "analog-modelling",
        "synth emulator",
        "(Gearmulator).",
        "",
        "Home of the SuperSaw.",
        "8-voice polyphony.",
        "",
        "Three modes:",
        " Patch: one sound,",
        "  Upper/Lower/Both",
        " Performance: two",
        "  parts, split or",
        "  layer, arpeggiator",
        " System: MIDI and",
        "  keyboard settings"
      ]
    },
    {
      "title": "Setup",
      "children": [
        {
          "title": "ROM Files",
          "lines": [
            "Requires the JP-8000",
            "v1.5 firmware dump:",
            "all 8 .mid files in",
            "the roms/ folder.",
            "",
            "Upload via Schwung",
            "Manager > Modules >",
            "JE-8086 > Assets."
          ]
        },
        {
          "title": "Banks",
          "lines": [
            "Drop extra patch or",
            "performance banks in",
            "the banks/ folder:",
            "",
            " .syx .j8k .mid",
            " .pat .pfm",
            "",
            "They appear beside",
            "Factory A/B in the",
            "Bank and Perf Bank",
            "menus.",
            "",
            "Sequence-only .mid",
            "files give no bank."
          ]
        },
        {
          "title": "CPU",
          "lines": [
            "The emulator runs as",
            "three pipelined",
            "stages on cores",
            "0-2, kept off the",
            "audio core.",
            "",
            "Only ONE JE-8086",
            "can run at a time."
          ]
        }
      ]
    },
    {
      "title": "Patch Mode",
      "lines": [
        "Jog: browse patches",
        "in the current bank.",
        "Click to open the",
        "editor.",
        "",
        "Knobs: Cutoff, Res,",
        "Filter Env, Amp",
        "A/D/S/R, Delay Level.",
        "",
        "Edit Part chooses",
        "Upper, Lower or",
        "Both. In Patch mode",
        "one part sounds.",
        "",
        "Sub-pages: Osc,",
        "Pitch, Filter, Amp,",
        "LFO, Effects, Play,",
        "Ribbon, Velocity."
      ]
    },
    {
      "title": "Performance Mode",
      "lines": [
        "Jog: browse",
        "performances in the",
        "current Perf Bank.",
        "",
        "Key Mode: Single,",
        "Dual (layer) or",
        "Split at Split Point.",
        "",
        "Sub-pages: Setup,",
        "Upper, Lower, Arp,",
        "Trigger.",
        "",
        "Upper/Lower set",
        "each part's patch,",
        "level, pan, channel."
      ]
    },
    {
      "title": "System Mode",
      "lines": [
        "Global settings that",
        "outlive the patch --",
        "the synth's own",
        "SHIFT/EXIT page.",
        "",
        "Main:",
        " Remote Ctrl Ch is",
        "  the note path the",
        "  ARPEGGIATOR hears.",
        "  Default 3. Change",
        "  it and the arp",
        "  goes quiet.",
        " Perf Ctrl Ch is",
        "  Off by default.",
        " Local, MIDI Sync.",
        "",
        "TxRx: whether CC",
        " edits and program",
        " changes are sent",
        " and received.",
        "",
        "Keyboard: Master",
        " Tune (50 = A440),",
        " octave Shift, Gate",
        " Time.",
        "",
        "Ribbon: Relative",
        " and Hold.",
        "",
        "Keyboard Shift, the",
        "Ribbon pair and",
        "Local address the",
        "keyboard's own",
        "hardware, so they",
        "may do nothing here",
        "until something",
        "drives them.",
        "",
        "These are NOT saved",
        "in a patch. They",
        "ride in the slot",
        "state, so a set, a",
        "preset or a",
        "snapshot keeps them."
      ]
    },
    {
      "title": "Presets & State",
      "lines": [
        "Loading a patch or",
        "performance replays",
        "its SysEx into the",
        "temp area; edits go",
        "straight to the",
        "synth.",
        "",
        "The whole temp area",
        "(both parts) is",
        "saved with the slot",
        "and restored on",
        "boot, so edits",
        "survive a restart."
      ]
    }
  ]
}
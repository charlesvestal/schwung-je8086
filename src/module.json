{
    "id": "jp8000",
    "name": "JE-8086",
    "abbrev": "JP",
    "version": "0.5.1",
    "description": "JE-8086 SuperSaw synth emulator (Gearmulator)",
    "author": "dsp56300/gearmulator (port: charlesvestal)",
    "dsp": "dsp.so",
    "api_version": 2,
    "standalone": false,
    "assets": [
        {
            "path": "roms",
            "label": "ROMs",
            "extensions": [
                ".mid"
            ],
            "description": "Requires the 8 .mid files of a JP-8000 v1.5 firmware bulk dump, 79,372 bytes each. A Roland dump names them _00001.mid to _00008.mid; the loader finds them by size, so other names still work but cannot be verified here.",
            "hint": "The emulator runs as three pipelined stages on cores 0-2, off the audio core. Only one JE-8086 can run at a time.",
            "hint_url": "https://github.com/charlesvestal/schwung-jp8000",
            "hint_url_label": "Read more",
            "files": [
                {
                    "filename": "_00001.mid",
                    "label": "Firmware 1 of 8",
                    "size": 79372,
                    "crc32": "3DB23BE1",
                    "required": true
                },
                {
                    "filename": "_00002.mid",
                    "label": "Firmware 2 of 8",
                    "size": 79372,
                    "crc32": "EA24A770",
                    "required": true
                },
                {
                    "filename": "_00003.mid",
                    "label": "Firmware 3 of 8",
                    "size": 79372,
                    "crc32": "D82A058D",
                    "required": true
                },
                {
                    "filename": "_00004.mid",
                    "label": "Firmware 4 of 8",
                    "size": 79372,
                    "crc32": "B552CF94",
                    "required": true
                },
                {
                    "filename": "_00005.mid",
                    "label": "Firmware 5 of 8",
                    "size": 79372,
                    "crc32": "DD568E7D",
                    "required": true
                },
                {
                    "filename": "_00006.mid",
                    "label": "Firmware 6 of 8",
                    "size": 79372,
                    "crc32": "B8323722",
                    "required": true
                },
                {
                    "filename": "_00007.mid",
                    "label": "Firmware 7 of 8",
                    "size": 79372,
                    "crc32": "11DAAB09",
                    "required": true
                },
                {
                    "filename": "_00008.mid",
                    "label": "Firmware 8 of 8",
                    "size": 79372,
                    "crc32": "440A3458",
                    "required": true
                }
            ]
        },
        {
            "path": "banks",
            "label": "Banks",
            "extensions": [
                ".syx",
                ".j8k",
                ".mid",
                ".MID",
                ".pat",
                ".pfm"
            ],
            "description": "Extra patch and performance banks. Nested folders are scanned, and each file becomes a bank in the browser beside Factory A/B.",
            "optional": true,
            "allowFolders": true
        }
    ],
    "capabilities": {
        "audio_out": true,
        "audio_in": false,
        "midi_in": true,
        "midi_out": false,
        "default_forward_channel": 3,
        "chainable": true,
        "component_type": "sound_generator",
        "forks_processes": true
    },
    "_chain_params_note": "Fallback only. The live contract (169 params + bank enums) is served by get_param('chain_params') in dsp/jp8000_plugin.cpp, generated from tools/gen_params.py into dsp/jp8000_params.h. Keys and ranges here mirror the patch_main knobs.",
    "chain_params": [
        {
            "key": "mode",
            "name": "Mode",
            "type": "enum",
            "options": [
                "Patch",
                "Performance"
            ],
            "default": 0
        },
        {
            "key": "part",
            "name": "Edit Part",
            "short_name": "Part",
            "type": "enum",
            "options": [
                "Upper",
                "Lower",
                "Both"
            ],
            "default": 0
        },
        {
            "key": "cutoff",
            "name": "Cutoff",
            "short_name": "Cut",
            "type": "int",
            "min": 0,
            "max": 127,
            "default": 127
        },
        {
